{
  "name": "@antenna/worker",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy ${SENTRY_RELEASE:+--var SENTRY_RELEASE:$SENTRY_RELEASE}",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply antenna --local",
    "r2:lifecycle": "wrangler r2 bucket lifecycle add antenna-payloads expire-raw-payloads-365d --expire-days 365 --force",
    "r2:lifecycle:list": "wrangler r2 bucket lifecycle list antenna-payloads"
  },
  "dependencies": {
    "@antenna/connectors": "*",
    "@antenna/mcp": "*",
    "@antenna/registry": "*",
    "@antenna/shared": "*",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sentry/cloudflare": "^10.68.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^12.0.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "wrangler": "^4.119.0"
  }
}
