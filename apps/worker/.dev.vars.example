# Antenna — Worker local-development secrets
#
# Copy this to `apps/worker/.dev.vars` and fill in. `.dev.vars` is
# gitignored and is loaded automatically by `wrangler dev`.
#
# In *production*, the same names are set via:
#   wrangler secret put NAME --config apps/worker/wrangler.toml
# (or from inside apps/worker: `wrangler secret put NAME`)

# Sign-in needs all four values in the next three sections. With any of them
# empty the Worker still starts and /healthz still answers, but the sign-in
# button fails. To look around without a Google client, use BYPASS_AUTH below.

# ----- Google OAuth -----
# From https://console.cloud.google.com/apis/credentials
# OAuth client: type = Web application
# Authorised redirect URI:
#   http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Better Auth -----
# 32-byte hex used by Better Auth to sign session cookies.
# Generate: `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# ----- Google token encryption -----
# 32-byte hex key for AES-GCM encryption of reusable provider tokens.
# Generate a second, different value: `openssl rand -hex 32`
ENCRYPTION_KEY=

# ----- Access policy -----
# Unset means any Google account may sign in, which is fine on localhost.
# Set ALLOWED_EMAILS to a comma-separated list to admit only those addresses;
# an address that is not on the list is refused, including your own.
# ALLOWED_EMAILS=you@example.com
# BLOCKED_EMAILS=
# ADMIN_EMAILS=you@example.com

# ----- Environment -----
# `wrangler dev` defaults to "development" if unset, but being explicit makes
# the BYPASS_AUTH gate (below) easy to reason about.
NODE_ENV=development

# ----- Local auth bypass -----
# Set to "1" to run without Google sign-in. The auth middleware then skips
# Better Auth and treats every request as the fixed local user
# { id: "e2e-user", email: "e2e@test.local" }, so the app opens signed in.
# It also skips the access lists above, for anyone who can reach the port:
# keep `wrangler dev` on localhost while it is on. The Playwright suite sets
# this itself. Hard-gated to NODE_ENV !== "production"; wrangler.toml pins
# NODE_ENV="production" on the deployed Worker so this can never leak there.
# BYPASS_AUTH=1

# ----- Optional connector credentials -----
# Higher GitHub API limits for GitHub-backed templates.
# GITHUB_TOKEN=
#
# Optional paid economic-data fallback.
# TRADING_ECONOMICS_API_KEY=

# ----- Optional private observability connectors -----
# Use distinct scoped tokens for independent deployments.
# BEACON_INGEST_TOKEN=
# CF_ANALYTICS_API_TOKEN=
# APP_HEALTH_MANIFEST={"my-app":"https://my-app.example/healthz"}

# ----- Optional error telemetry -----
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
