# Antenna — Worker local-development secrets
#
# Copy this to `apps/worker/.dev.vars` and fill in. `.dev.vars` is
# gitignored and is loaded automatically by `wrangler dev`.
#
# In *production*, the same names are set via:
#   wrangler secret put NAME --config apps/worker/wrangler.toml
# (or from inside apps/worker: `wrangler secret put NAME`)

# ----- Google OAuth -----
# From https://console.cloud.google.com/apis/credentials
# OAuth client: type = Web application
# Authorised redirect URI:
#   http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Better Auth -----
# 32-byte hex used by Better Auth to sign session cookies.
# Generate: `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# ----- Sign-in allowlist -----
# Comma-separated list of email addresses allowed to sign in.
ALLOWED_EMAILS=owner@example.com

# ----- Environment -----
# `wrangler dev` defaults to "development" if unset, but being explicit makes
# the BYPASS_AUTH gate (below) easy to reason about.
NODE_ENV=development

# ----- E2E auth bypass -----
# Set to "1" ONLY when running the Playwright suite against `wrangler dev`.
# When active, the auth middleware skips Better Auth entirely and injects a
# fake { id: "e2e-user", email: "e2e@test.local" } principal. Hard-gated to
# NODE_ENV !== "production"; wrangler.toml pins NODE_ENV="production" on the
# deployed Worker so this can never accidentally leak.
# BYPASS_AUTH=1

# ----- Optional connector credentials -----
# Higher GitHub API limits for GitHub-backed templates.
# GITHUB_TOKEN=
#
# Optional paid economic-data fallback.
# TRADING_ECONOMICS_API_KEY=

# ----- Optional notifications -----
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=Antenna <antenna@example.com>

# ----- Optional application usage ingestion -----
# Use distinct scoped tokens for independent deployments.
# BEACON_INGEST_TOKEN=
# CF_ANALYTICS_API_TOKEN=

# ----- Optional observability and abuse protection -----
# SENTRY_DSN=
# PUBLIC_COLLECTION_REPORT_SALT=
