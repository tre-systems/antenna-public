{
  "name": "@antenna/mcp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./factory": {
      "types": "./src/factory.ts",
      "import": "./dist/factory.js",
      "default": "./dist/factory.js"
    }
