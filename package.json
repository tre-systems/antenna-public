{
  "name": "antenna",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "diagrams": "node scripts/render-diagrams.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,html}\"",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:public-release": "node scripts/check-public-release.mjs",
    "size:report": "node scripts/report-size.mjs",
    "check:bundle": "npm run build --workspace=apps/web && node scripts/check-bundle-size.mjs",
    "audit:security": "npm audit --audit-level=moderate",
    "lint": "eslint \"apps/**/*.{ts,tsx,js,mjs}\" \"packages/**/*.{ts,tsx,js,mjs}\" \"scripts/**/*.mjs\" \"*.config.{ts,js,mjs}\"",
    "lint:fix": "eslint \"apps/**/*.{ts,tsx,js,mjs}\" \"packages/**/*.{ts,tsx,js,mjs}\" \"scripts/**/*.mjs\" \"*.config.{ts,js,mjs}\" --fix",
    "smoke:mcp": "node scripts/smoke-mcp-dist.mjs",
    "smoke:mcp:http": "node scripts/smoke-mcp-http.mjs",
    "smoke:prompts": "vitest run apps/worker/src/planner/prompt-parity.smoke.test.ts",
    "skill:templates": "node scripts/update-skill-templates.mjs --write",
    "skill:templates:check": "node scripts/update-skill-templates.mjs --check",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:contracts": "vitest run apps/worker/src/routes/public-collections.test.ts apps/worker/src/routes/shared-collections.test.ts apps/worker/src/policy/source-access.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "test:e2e:a11y": "node scripts/run-e2e-tests.mjs tests/e2e/a11y.spec.ts",
    "verify": "npm run format:check && npm run check:doc-links && npm run check:imports && npm run check:public-release && npm run lint && npm run typecheck && npm run skill:templates:check && npm run smoke:mcp && npm run smoke:prompts && npm run check:diagrams && npm run test:unit",
    "build": "npm run build --workspace=@antenna/mcp && npm run build --workspace=apps/web",
    "deploy": "npm run build --workspace=@antenna/mcp && npm run build --workspace=apps/web && npm run deploy --workspace=apps/worker",
    "deps": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && npm run nuke",
    "nuke": "rm -rf node_modules package-lock.json && npm install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,css,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "esbuild": "^0.28.1"
  },
  "license": "MIT"
}
