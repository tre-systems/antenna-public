digraph SignalLifecycle {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.45",
    nodesep="0.62",
    ranksep="0.72",
    splines=polyline,
    outputorder=edgesfirst,
    newrank=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Signal Status Lifecycle</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">Persisted status records the latest outcome; retry timing is an orthogonal gate.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.28,0.17",
    width=2.8,
    fontname="Avenir",
    fontsize=18,
    penwidth=2.3,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff"
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=12,
    fontcolor="#3d4a5c",
    penwidth=2.0,
    arrowsize=0.78
  ];

  CREATED [label=<<B>Signal created</B><BR/><FONT POINT-SIZE="13">signal row plus loading status</FONT>>, color="#5b6b80", fillcolor="#e0e7ef"];
  LOADING [label=<<B>loading</B><BR/><FONT POINT-SIZE="13">no completed initial fetch yet</FONT>>, color="#2f80ed", fillcolor="#edf7ff"];
  ATTEMPT [label=<<B>Dispatcher attempt</B><BR/><FONT POINT-SIZE="13">policy gate, optional shared snapshot, adapter</FONT>>, color="#d39a00", fillcolor="#fff4d1"];

  LIVE [label=<<B>live</B><BR/><FONT POINT-SIZE="13">successful result; last_ok_at advances</FONT>>, color="#15803d", fillcolor="#d8f5de", penwidth=3.0];
  STALE [label=<<B>stale</B><BR/><FONT POINT-SIZE="13">recoverable failure with a prior good value</FONT>>, color="#d39a00", fillcolor="#fff4d1", penwidth=3.0];
  ERROR [label=<<B>error</B><BR/><FONT POINT-SIZE="13">setup, auth, policy, parse, or initial failure</FONT>>, color="#c53030", fillcolor="#fde2e1", penwidth=3.0];

  RETRY [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD><B>Retry gate (not a status)</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">next_attempt_at delays scheduled selection</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">manual refresh requests may take priority</FONT></TD></TR>
    </TABLE>
  >, color="#6b7280", fillcolor="#ffffff", style="rounded,filled,dashed"];

  PRESENTATION [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD><B>Additional PWA freshness rule</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">a live row is presented as stale when last_ok_at</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">is older than 2 × refresh_seconds</FONT></TD></TR>
    </TABLE>
  >, shape=note, color="#6b7280", fillcolor="#f8fafc", fontsize=15];

  DELETED [label=<<B>deleted</B><BR/><FONT POINT-SIZE="13">owner deletion removes signal and children</FONT>>, color="#7a7a7a", fillcolor="#e5e5e5"];

  CREATED -> LOADING -> ATTEMPT;
  ATTEMPT -> LIVE [label="success"];
  ATTEMPT -> STALE [label="recoverable failure + prior success"];
  ATTEMPT -> ERROR [label="other expected or unexpected failure"];

  LIVE -> RETRY [label="refresh becomes due", style=dashed, color="#6b7280"];
  STALE -> RETRY [label="backoff", style=dashed, color="#6b7280"];
  ERROR -> RETRY [label="backoff", style=dashed, color="#6b7280"];
  RETRY -> ATTEMPT [label="eligible", style=dashed, color="#6b7280"];

  LIVE -> PRESENTATION [label="age check", style=dashed, color="#6b7280"];

  LIVE -> DELETED [label="owner DELETE", color="#7a7a7a"];
  STALE -> DELETED [label="owner DELETE", color="#7a7a7a"];
  ERROR -> DELETED [label="owner DELETE", color="#7a7a7a"];
  LOADING -> DELETED [label="owner DELETE", color="#7a7a7a"];

  { rank=same; LIVE; STALE; ERROR; }
  { rank=same; RETRY; PRESENTATION; }
}
