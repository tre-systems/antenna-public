digraph DataModel {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.45",
    nodesep="0.55",
    ranksep="0.82",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Operational Data Relationships</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">Focused on ownership, authoring, and ingestion—not a column-level schema copy.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.24,0.14",
    width=2.75,
    fontname="Avenir",
    fontsize=16,
    penwidth=2.1,
    fontcolor="#14213d",
    color="#0f766e",
    fillcolor="#e6fffb"
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=11,
    fontcolor="#3d4a5c",
    penwidth=1.9,
    arrowsize=0.72
  ];

  subgraph cluster_identity {
    graph [
      label=<<B>IDENTITY AND AGENT ACCESS</B>>,
      color="#99d5cf",
      fillcolor="#f0fdfa",
      style="rounded,filled",
      fontname="Avenir",
      fontcolor="#0f766e",
      penwidth=1.7
    ];

    USER [label=<<B>user</B><BR/><FONT POINT-SIZE="12">Google profile and Antenna onboarding markers</FONT>>];
    BA [label=<<B>Better Auth records</B><BR/><FONT POINT-SIZE="12">account · session · verification</FONT>>];
    MCP [label=<<B>MCP access records</B><BR/><FONT POINT-SIZE="12">OAuth clients/grants/consent · legacy token hashes</FONT>>];

    USER -> BA [label="1 : many"];
    USER -> MCP [label="1 : many"];
    { rank=same; USER; BA; MCP; }
  }

  subgraph cluster_workspace {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
          <TR><TD ALIGN="LEFT"><FONT COLOR="#1e6b43"><B>OWNER WORKSPACE</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4e7a61">A collection is the tenant boundary.</FONT></TD></TR>
        </TABLE>
      >,
      color="#b8e5c8",
      fillcolor="#f4fbf6",
      style="rounded,filled",
      penwidth=1.7
    ];

    COLLECTION [label=<<B>collections</B><BR/><FONT POINT-SIZE="12">owner · visibility · refresh mode · layout</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    SIGNAL [label=<<B>signals</B><BR/><FONT POINT-SIZE="12">template id · config · cadence · position · visibility</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    VISIT [label=<<B>user_collection_visits</B><BR/><FONT POINT-SIZE="12">owner's last-seen marker</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    DISMISS [label=<<B>dismissed_starter_signals</B><BR/><FONT POINT-SIZE="12">do not recreate removed defaults</FONT>>, color="#22865a", fillcolor="#eaf8ef"];

    COLLECTION -> SIGNAL [label="1 : many"];
    COLLECTION -> VISIT [label="1 : many"];
    COLLECTION -> DISMISS [label="1 : many"];
    { rank=same; VISIT; COLLECTION; DISMISS; }
  }

  subgraph cluster_authoring {
    graph [
      label=<<B>AUTHORING HISTORY</B>>,
      color="#d6c6ee",
      fillcolor="#fbf8ff",
      style="rounded,filled",
      fontname="Avenir",
      fontcolor="#5f3b8a",
      penwidth=1.7
    ];

    PLAN [label=<<B>collection_plans</B><BR/><FONT POINT-SIZE="12">stored proposal · proposed/confirmed/rejected</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    CLAIM [label=<<B>plan_confirmation_claims</B><BR/><FONT POINT-SIZE="12">one unique confirmation claim per plan</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    REQUEST [label=<<B>connector_requests</B><BR/><FONT POINT-SIZE="12">unsupported demand and build state</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];

    PLAN -> CLAIM [label="0 : 1"];
    { rank=same; PLAN; REQUEST; }
  }

  subgraph cluster_runtime {
    graph [
      label=<<B>SIGNAL RUNTIME</B>>,
      color="#e7c86e",
      fillcolor="#fffaf0",
      style="rounded,filled",
      fontname="Avenir",
      fontcolor="#8a6200",
      penwidth=1.7
    ];

    STATUS [label=<<B>signal_status</B><BR/><FONT POINT-SIZE="12">attempt/success/error · retry gate · snapshot hash</FONT>>, color="#d39a00", fillcolor="#fff4d1"];
    POINT [label=<<B>signal_points</B><BR/><FONT POINT-SIZE="12">idempotent current/history observations</FONT>>, color="#d39a00", fillcolor="#fff4d1"];
    ALERT [label=<<B>signal_alerts</B><BR/><FONT POINT-SIZE="12">rule hits with previous and observed values</FONT>>, color="#d39a00", fillcolor="#fff4d1"];
    SNAPSHOT [label=<<B>upstream_snapshots</B><BR/><FONT POINT-SIZE="12">public-cloud normalized fetch cache</FONT>>, color="#d39a00", fillcolor="#fff4d1"];
    RAW [label=<<B>R2 payload objects</B><BR/><FONT POINT-SIZE="12">reviewed opt-in archive with lifecycle expiry</FONT>>, color="#0f766e", fillcolor="#e6fffb"];

    STATUS -> POINT [style=invis];
    POINT -> ALERT [style=invis];
    { rank=same; STATUS; POINT; ALERT; }
    { rank=same; SNAPSHOT; RAW; }
  }

  REGISTRY [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD><B>Static server registry (code)</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="12">template schemas · source policy · execution mode · display metadata</FONT></TD></TR>
    </TABLE>
  >, color="#7c3aed", fillcolor="#f5f3ff"];

  USER -> COLLECTION [label="owns (logical)", lhead=cluster_workspace];
  COLLECTION -> PLAN [label="1 : many", lhead=cluster_authoring];
  COLLECTION -> REQUEST [label="0 : many", lhead=cluster_authoring];
  CLAIM -> SIGNAL [label="confirmation creates", lhead=cluster_workspace, style=dashed, color="#6b7280"];

  SIGNAL -> STATUS [label="1 : 1", lhead=cluster_runtime];
  SIGNAL -> POINT [label="1 : many", lhead=cluster_runtime];
  SIGNAL -> ALERT [label="1 : many", lhead=cluster_runtime];
  SNAPSHOT -> SIGNAL [label="reused fetch; never ownership", style=dashed, color="#6b7280"];
  POINT -> RAW [label="optional raw_payload_id", style=dashed, color="#6b7280"];

  REGISTRY -> SIGNAL [label="template identity + policy", style=dashed, color="#6b7280"];
  REGISTRY -> COLLECTION [style=invis, weight=10];
}
