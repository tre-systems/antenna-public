digraph SystemOverview {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.45",
    nodesep="0.55",
    ranksep="0.72",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Antenna System</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">One Worker owns every protocol, policy decision, and durable write.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.23,0.14",
    fontname="Avenir",
    fontsize=17,
    penwidth=2.2,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff"
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=12,
    fontcolor="#3d4a5c",
    penwidth=2.0,
    arrowsize=0.75
  ];

  subgraph cluster_clients {
    graph [
      label=<<B>CLIENTS AND PRODUCERS</B>>,
      color="#b9d8ff",
      fillcolor="#f5faff",
      style="rounded,filled",
      fontname="Avenir",
      fontcolor="#1f5fbf",
      penwidth=1.7
    ];

    PWA [label=<<B>Browser / installed PWA</B><BR/><FONT POINT-SIZE="13">Preact, signals, service worker</FONT>>];
    AGENT [label=<<B>Codex and MCP clients</B><BR/><FONT POINT-SIZE="13">OAuth Streamable HTTP or local stdio</FONT>>];
    APPS [label=<<B>Instrumented apps</B><BR/><FONT POINT-SIZE="13">approved usage beacon events</FONT>>];
    { rank=same; PWA; AGENT; APPS; }
  }

  subgraph cluster_worker {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1e6b43"><B>CLOUDFLARE WORKER</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4e7a61">HTTP, hosted MCP, static assets, cron, and Durable Object bindings deploy together.</FONT></TD></TR>
        </TABLE>
      >,
      color="#b8e5c8",
      fillcolor="#f4fbf6",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    STATIC [label=<<B>Static Assets</B><BR/><FONT POINT-SIZE="13">PWA shell and generated service worker</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    GATEWAY [label=<<B>Hono edge routes</B><BR/><FONT POINT-SIZE="13">JSON API · SSE · beacon · hosted MCP</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    AUTH [label=<<B>Better Auth</B><BR/><FONT POINT-SIZE="13">Google sessions and MCP OAuth</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    CORE [label=<<B>Application core</B><BR/><FONT POINT-SIZE="13">owner scope · planner · registry policy · display</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    CRON [label=<<B>Bounded scheduled ingestion</B><BR/><FONT POINT-SIZE="13">one-minute cron · 250 due · 8 lanes</FONT>>, color="#d39a00", fillcolor="#fff4d1"];
    ADAPTERS [label=<<B>Effect-isolated adapters</B><BR/><FONT POINT-SIZE="13">native fetch and narrow source parsers</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    DO [label=<<B>Durable Objects</B><BR/><FONT POINT-SIZE="13">collection SSE fan-out · abuse budgets</FONT>>, color="#22865a", fillcolor="#eaf8ef"];

    { rank=same; STATIC; GATEWAY; }
    { rank=same; AUTH; CORE; CRON; }
    { rank=same; ADAPTERS; DO; }

    GATEWAY -> AUTH [label="authenticate"];
    GATEWAY -> CORE [label="validate + execute"];
    GATEWAY -> DO [label="subscribe / count"];
    CRON -> CORE [label="resolve policy", style=dashed, color="#6b7280"];
    CRON -> ADAPTERS [label="invoke"];
    CRON -> DO [label="best-effort notify"];
  }

  subgraph cluster_state {
    graph [
      label=<<B>DURABLE STATE AND TELEMETRY</B>>,
      color="#99d5cf",
      fillcolor="#f0fdfa",
      style="rounded,filled",
      fontname="Avenir",
      fontcolor="#0f766e",
      penwidth=1.7
    ];

    D1 [label=<<B>D1</B><BR/><FONT POINT-SIZE="13">identity, collections, plans, signals, history</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    R2 [label=<<B>R2</B><BR/><FONT POINT-SIZE="13">reviewed raw payload archive only</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    AE [label=<<B>Analytics Engine</B><BR/><FONT POINT-SIZE="13">app usage events and aggregates</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    SENTRY [label=<<B>Sentry</B><BR/><FONT POINT-SIZE="13">exceptions, request context, cron spans</FONT>>, color="#2f80ed", fillcolor="#edf7ff"];
    { rank=same; D1; R2; AE; SENTRY; }
  }

  subgraph cluster_external {
    graph [
      label=<<B>EXTERNAL SERVICES</B>>,
      color="#d6c6ee",
      fillcolor="#fbf8ff",
      style="rounded,filled",
      fontname="Avenir",
      fontcolor="#5f3b8a",
      penwidth=1.7
    ];

    GOOGLE [label=<<B>Google Identity</B><BR/><FONT POINT-SIZE="13">profile-only OAuth scopes</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    SOURCES [label=<<B>Reviewed data sources</B><BR/><FONT POINT-SIZE="13">public APIs and approved private-cloud APIs</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    { rank=same; GOOGLE; SOURCES; }
  }

  PWA -> STATIC [label="load shell"];
  PWA -> GATEWAY [label="HTTPS"];
  GATEWAY -> PWA [label="server-owned JSON", constraint=false];
  AGENT -> GATEWAY [label="MCP"];
  APPS -> GATEWAY [label="token-authenticated beacon"];

  AUTH -> GOOGLE [label="OAuth"];
  AUTH -> D1 [label="sessions + grants"];
  CORE -> D1 [label="owner-scoped reads / writes"];
  CRON -> D1 [label="due work + results"];
  CRON -> R2 [label="opt-in raw payload", style=dashed, color="#6b7280"];
  ADAPTERS -> SOURCES [label="fetch"];
  GATEWAY -> AE [label="usage events"];
  PWA -> SENTRY [label="browser failures", style=dashed, color="#6b7280"];
  GATEWAY -> SENTRY [label="request failures", style=dashed, color="#6b7280"];
  CRON -> SENTRY [label="cron spans / failures", style=dashed, color="#6b7280"];
  DO -> PWA [label="SSE invalidation", constraint=false];
}
