digraph IngestionFlow {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.45",
    nodesep="0.52",
    ranksep="0.66",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Scheduled Signal Ingestion</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">Bounded selection, policy before fetch, signal-scoped persistence.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.24,0.14",
    width=3.1,
    fontname="Avenir",
    fontsize=17,
    penwidth=2.2,
    fontcolor="#14213d",
    color="#22865a",
    fillcolor="#eaf8ef"
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=12,
    fontcolor="#3d4a5c",
    penwidth=2.0,
    arrowsize=0.75
  ];

  CRON [label=<<B>Cloudflare Cron Trigger</B><BR/><FONT POINT-SIZE="13">every minute; jobs isolated by scheduled.ts</FONT>>, color="#d39a00", fillcolor="#fff4d1"];

  subgraph cluster_dispatch {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1e6b43"><B>BOUNDED DISPATCH</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4e7a61">One slow source occupies one lane, not the whole tick.</FONT></TD></TR>
        </TABLE>
      >,
      color="#b8e5c8",
      fillcolor="#f4fbf6",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    DUE [label=<<B>Select at most 250 due signals</B><BR/><FONT POINT-SIZE="13">manual requests first; then oldest attempt</FONT>>];
    LANES [label=<<B>Process through 8 lanes</B><BR/><FONT POINT-SIZE="13">joined collection supplies visibility and tenant context</FONT>>];
    GUARD [label=<<B>Resolve and validate</B><BR/><FONT POINT-SIZE="13">template · config · source policy · execution mode · secret</FONT>>];
    ELIGIBLE [label=<<B>Cloud refresh allowed?</B>>, shape=diamond, width=3.0, height=1.0, color="#1f2f46", fillcolor="#ffffff"];

    DUE -> LANES -> GUARD -> ELIGIBLE;
  }

  subgraph cluster_fetch {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#5f3b8a"><B>FETCH</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#6d4d8d">Only reviewed public-cloud, config-only results may cross owners.</FONT></TD></TR>
        </TABLE>
      >,
      color="#d6c6ee",
      fillcolor="#fbf8ff",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    SHAREABLE [label=<<B>Shared snapshot eligible?</B>>, shape=diamond, width=3.0, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
    CACHE [label=<<B>Canonical shared snapshot</B><BR/><FONT POINT-SIZE="13">read stored/same-tick result; store successful misses</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    HIT [label=<<B>Fresh snapshot?</B>>, shape=diamond, width=2.7, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
    ADAPTER [label=<<B>Run effect-isolated adapter</B><BR/><FONT POINT-SIZE="13">native fetch + narrow parse → AdapterResult</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    RESULT [label=<<B>Expected source success?</B>>, shape=diamond, width=3.2, height=1.0, color="#1f2f46", fillcolor="#ffffff"];

    SHAREABLE -> CACHE [label="yes"];
    CACHE -> HIT;
    HIT -> ADAPTER [label="miss"];
    SHAREABLE -> ADAPTER [label="no"];
    ADAPTER -> RESULT;
  }

  SUCCESS [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD><B>Materialize successful result</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">hash normalized snapshot; evaluate alerts if changed</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">upsert points if needed; optionally archive reviewed raw payload</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">write live status and last_ok_at</FONT></TD></TR>
    </TABLE>
  >, color="#0f766e", fillcolor="#e6fffb"];

  FAILURE [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD><B>Record signal-scoped failure</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">recoverable + prior success → stale; otherwise error</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">sanitize last_error and set next_attempt_at</FONT></TD></TR>
    </TABLE>
  >, color="#c53030", fillcolor="#fde2e1"];

  BLOCKED [label=<<B>Record setup-required error</B><BR/><FONT POINT-SIZE="13">no external request; retry gate prevents hot looping</FONT>>, color="#c53030", fillcolor="#fde2e1"];

  NOTIFY [label=<<B>Best-effort CollectionChannel event</B><BR/><FONT POINT-SIZE="13">SSE is invalidation only; clients refetch D1 truth</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
  LOG [label=<<B>Structured completion event</B><BR/><FONT POINT-SIZE="13">run, signal, collection, template, status, saturation</FONT>>, color="#2f80ed", fillcolor="#edf7ff"];

  CRON -> DUE [lhead=cluster_dispatch];
  ELIGIBLE -> SHAREABLE [label="yes", ltail=cluster_dispatch, lhead=cluster_fetch];
  ELIGIBLE -> BLOCKED [label="no"];
  HIT -> SUCCESS [label="hit", ltail=cluster_fetch];
  RESULT -> SUCCESS [label="yes", ltail=cluster_fetch];
  RESULT -> FAILURE [label="no", ltail=cluster_fetch];

  SUCCESS -> NOTIFY;
  FAILURE -> NOTIFY;
  BLOCKED -> NOTIFY;
  NOTIFY -> LOG;

  { rank=same; SUCCESS; FAILURE; BLOCKED; }
}
