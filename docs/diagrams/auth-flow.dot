digraph AuthFlow {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.45",
    nodesep="0.58",
    ranksep="0.68",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Google Sign-In via Better Auth</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">Profile-only OAuth; reusable provider tokens are encrypted before D1 persistence.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.24,0.14",
    width=3.2,
    fontname="Avenir",
    fontsize=17,
    penwidth=2.2,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff"
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=12,
    fontcolor="#3d4a5c",
    penwidth=2.0,
    arrowsize=0.75
  ];

  START [label=<<B>Owner selects “Sign in with Google”</B><BR/><FONT POINT-SIZE="13">browser calls Better Auth social sign-in route</FONT>>];

  subgraph cluster_better_auth {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1e6b43"><B>CLOUDFLARE WORKER · BETTER AUTH</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4e7a61">Better Auth owns protocol handling; Antenna hooks own access policy and provisioning.</FONT></TD></TR>
        </TABLE>
      >,
      color="#b8e5c8",
      fillcolor="#f4fbf6",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    BEGIN [label=<<B>Create authorization request</B><BR/><FONT POINT-SIZE="13">server-side state · PKCE · openid/email/profile</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    CALLBACK [label=<<B>Validate Google callback</B><BR/><FONT POINT-SIZE="13">state, code exchange, provider identity</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    ACCESS [label=<<B>Email permitted?</B>>, shape=diamond, width=2.8, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
    PROTECT [label=<<B>Protect and persist identity</B><BR/><FONT POINT-SIZE="13">AES-GCM access/refresh tokens; discard ID token</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    PROVISION [label=<<B>Run Antenna hooks</B><BR/><FONT POINT-SIZE="13">ensure an owned collection; restore it if missing</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    SESSION [label=<<B>Issue Better Auth session</B><BR/><FONT POINT-SIZE="13">signed cookie backed by an expiring D1 row</FONT>>, color="#15803d", fillcolor="#d8f5de", penwidth=3.0];

    BEGIN -> CALLBACK [style=invis];
    CALLBACK -> ACCESS -> PROTECT -> PROVISION -> SESSION;
  }

  subgraph cluster_google {
    graph [
      label=<<B>GOOGLE IDENTITY</B>>,
      color="#d6c6ee",
      fillcolor="#fbf8ff",
      style="rounded,filled",
      fontname="Avenir",
      fontcolor="#5f3b8a",
      penwidth=1.7
    ];

    CONSENT [label=<<B>Authenticate and consent</B><BR/><FONT POINT-SIZE="13">Google returns a one-time authorization code</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
  }

  REFUSED [label=<<B>Abort without a session</B><BR/><FONT POINT-SIZE="13">redirect to PWA with blocked or not_invited error</FONT>>, color="#c53030", fillcolor="#fde2e1", penwidth=3.0];
  READY [label=<<B>Signed-in PWA</B><BR/><FONT POINT-SIZE="13">every authenticated request rechecks current access policy</FONT>>, color="#15803d", fillcolor="#d8f5de", penwidth=3.0];
  D1 [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD><B>D1 auth and workspace rows</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">verification · user · account · session · collection</FONT></TD></TR>
    </TABLE>
  >, color="#0f766e", fillcolor="#e6fffb"];

  START -> BEGIN [label="1"];
  BEGIN -> CONSENT [label="2 · redirect", ltail=cluster_better_auth, lhead=cluster_google];
  CONSENT -> CALLBACK [label="3 · code + state", ltail=cluster_google, lhead=cluster_better_auth];
  ACCESS -> REFUSED [label="no"];
  SESSION -> READY [label="4 · session cookie", ltail=cluster_better_auth];

  BEGIN -> D1 [label="state", style=dashed, color="#6b7280"];
  PROTECT -> D1 [label="identity", style=dashed, color="#6b7280"];
  PROVISION -> D1 [label="workspace", style=dashed, color="#6b7280"];
  SESSION -> D1 [label="session", style=dashed, color="#6b7280"];

  { rank=same; REFUSED; READY; D1; }
}
