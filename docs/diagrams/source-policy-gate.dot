digraph SourcePolicyGate {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.45",
    nodesep="0.62",
    ranksep="0.68",
    splines=polyline,
    outputorder=edgesfirst,
    newrank=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Signal Read Authority</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">Owner access and external visibility are deliberately different contracts.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.25,0.15",
    width=3.2,
    fontname="Avenir",
    fontsize=17,
    penwidth=2.2,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff"
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=12,
    fontcolor="#3d4a5c",
    penwidth=2.0,
    arrowsize=0.75
  ];

  REQUEST [label=<<B>Signal read request</B><BR/><FONT POINT-SIZE="13">authenticated API, shared capability, or public route</FONT>>];
  AUDIENCE [label=<<B>Audience?</B>>, shape=diamond, width=2.5, height=1.0, color="#1f2f46", fillcolor="#ffffff"];

  OWNER_SCOPE [label=<<B>Join through owned collection</B><BR/><FONT POINT-SIZE="13">another tenant's ids look absent</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
  OWNER_FOUND [label=<<B>Owned signal found?</B>>, shape=diamond, width=2.8, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
  OWNER [label=<<B>Return owner signal</B><BR/><FONT POINT-SIZE="13">config and cadence included; credentials and secrets never returned</FONT>>, color="#15803d", fillcolor="#d8f5de", penwidth=3.0];

  CAPABILITY [label=<<B>Resolve external collection</B><BR/><FONT POINT-SIZE="13">valid slug plus shared/public route contract</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
  VISIBILITY [label=<<B>Collection and signal visible?</B>>, shape=diamond, width=3.5, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
  POLICY [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD><B>Server source policy permits display?</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">policy exists · public-display eligible · public-cloud execution</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="13">rights are public or with-attribution</FONT></TD></TR>
    </TABLE>
  >, shape=diamond, width=4.8, height=1.25, color="#1f2f46", fillcolor="#ffffff"];
  EXTERNAL [label=<<B>Return public-safe projection</B><BR/><FONT POINT-SIZE="13">owner config/cadence omitted; source attribution retained</FONT>>, color="#15803d", fillcolor="#d8f5de", penwidth=3.0];

  NOT_FOUND [label=<<B>404 Not Found</B><BR/><FONT POINT-SIZE="13">do not confirm private, blocked, or cross-owner existence</FONT>>, color="#c53030", fillcolor="#fde2e1", penwidth=3.0];

  REQUEST -> AUDIENCE;
  AUDIENCE -> OWNER_SCOPE [label="owner"];
  AUDIENCE -> CAPABILITY [label="shared / public"];

  OWNER_SCOPE -> OWNER_FOUND;
  OWNER_FOUND -> OWNER [label="yes"];
  OWNER_FOUND -> NOT_FOUND [label="no"];

  CAPABILITY -> VISIBILITY;
  VISIBILITY -> POLICY [label="yes"];
  VISIBILITY -> NOT_FOUND [label="no"];
  POLICY -> EXTERNAL [label="yes"];
  POLICY -> NOT_FOUND [label="no"];

  { rank=same; OWNER_SCOPE; CAPABILITY; }
  { rank=same; OWNER; EXTERNAL; NOT_FOUND; }
}
