digraph SignalAuthoring {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.45",
    nodesep="0.52",
    ranksep="0.66",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Agent-First Signal Authoring</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">Proposal and confirmation stay separate; only the Worker grants authority.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.24,0.14",
    width=3.0,
    fontname="Avenir",
    fontsize=17,
    penwidth=2.2,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff"
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=12,
    fontcolor="#3d4a5c",
    penwidth=2.0,
    arrowsize=0.75
  ];

  AGENT [label=<<B>Codex via Antenna MCP</B><BR/><FONT POINT-SIZE="13">primary authoring path</FONT>>];
  BROWSER [label=<<B>Onboarding composer</B><BR/><FONT POINT-SIZE="13">first-signal browser fallback</FONT>>];
  { rank=same; AGENT; BROWSER; }

  REQUEST [label=<<B>Proposal request</B><BR/><FONT POINT-SIZE="13">natural-language prompt or exact template id</FONT>>, color="#22865a", fillcolor="#eaf8ef"];

  subgraph cluster_plan {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1e6b43"><B>WORKER: PLAN ONLY</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4e7a61">No signal or upstream fetch exists yet.</FONT></TD></TR>
        </TABLE>
      >,
      color="#b8e5c8",
      fillcolor="#f4fbf6",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    TARGET [label=<<B>Resolve owned collection</B><BR/><FONT POINT-SIZE="13">unknown and cross-owner ids look absent</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    KIND [label=<<B>Proposal kind?</B>>, shape=diamond, width=2.8, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
    MATCHER [label=<<B>Run deterministic matcher</B><BR/><FONT POINT-SIZE="13">produce matched signals plus unmatched fragments</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    EXACT [label=<<B>Resolve exact registry template</B><BR/><FONT POINT-SIZE="13">must permit direct proposals</FONT>>, color="#7c3aed", fillcolor="#f5f3ff"];
    EXACT_OK [label=<<B>Valid exact id?</B>>, shape=diamond, width=2.7, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
    PLAN [label=<<B>Persist CollectionPlan</B><BR/><FONT POINT-SIZE="13">intent, missing fields, source and rights metadata</FONT>>, color="#22865a", fillcolor="#eaf8ef"];
    REQUEST_ROW [label=<<B>Persist connector request</B><BR/><FONT POINT-SIZE="13">unmatched prompt only; unknown exact ids are rejected</FONT>>, color="#d39a00", fillcolor="#fff4d1"];
    UNKNOWN [label=<<B>unknown_template</B><BR/><FONT POINT-SIZE="13">no plan and no setup request</FONT>>, color="#c53030", fillcolor="#fde2e1"];
    HAS_SIGNAL [label=<<B>Any proposed signal?</B>>, shape=diamond, width=3.0, height=1.0, color="#1f2f46", fillcolor="#ffffff"];

    TARGET -> KIND;
    KIND -> MATCHER [label="prompt"];
    KIND -> EXACT [label="exact id"];
    EXACT -> EXACT_OK;
    EXACT_OK -> PLAN [label="yes"];
    EXACT_OK -> UNKNOWN [label="no"];
    MATCHER -> PLAN;
    PLAN -> REQUEST_ROW [label="for unmatched fragments", style=dashed, color="#6b7280"];
    PLAN -> HAS_SIGNAL;
  }

  REVIEW [label=<<B>Codex or onboarding UI presents proposal</B><BR/><FONT POINT-SIZE="13">owner sees target, params, cadence, source, and blockers</FONT>>];
  SETUP [label=<<B>Agent reports a setup request</B><BR/><FONT POINT-SIZE="13">the owner can add the missing connector or configuration</FONT>>, color="#d39a00", fillcolor="#fff4d1"];
  APPROVE [label=<<B>Owner approves?</B>>, shape=diamond, width=2.6, height=1.0, color="#1f2f46", fillcolor="#ffffff"];
  REJECT [label=<<B>Reject plan</B><BR/><FONT POINT-SIZE="13">no signal created</FONT>>, color="#c53030", fillcolor="#fde2e1"];

  subgraph cluster_confirm {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#0f766e"><B>WORKER: CONFIRMATION</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#357a74">The confirmation payload is a patch, never a signal definition.</FONT></TD></TR>
        </TABLE>
      >,
      color="#99d5cf",
      fillcolor="#f0fdfa",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    CONFIRM [label=<<B>Confirm stored plan</B><BR/><FONT POINT-SIZE="13">MCP tool or HTTP route; missing-parameter patches only</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    GUARDS [label=<<B>Re-check all authority</B><BR/><FONT POINT-SIZE="13">owner scope · proposed state · quota · registry · config</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    WRITE [label=<<B>Transactional D1 batch</B><BR/><FONT POINT-SIZE="13">unique claim · signals · loading statuses · confirmed plan</FONT>>, color="#0f766e", fillcolor="#e6fffb"];
    CREATED [label=<<B>Signals created</B><BR/><FONT POINT-SIZE="13">private unless source policy permits collection visibility</FONT>>, color="#15803d", fillcolor="#d8f5de", penwidth=3.0];

    CONFIRM -> GUARDS -> WRITE -> CREATED;
  }

  CRON [label=<<B>Next bounded cron tick</B><BR/><FONT POINT-SIZE="13">adapter fetches asynchronously; UI/MCP later reads values</FONT>>, color="#d39a00", fillcolor="#fff4d1"];

  AGENT -> REQUEST [label="propose_signal / propose_template_signal"];
  BROWSER -> REQUEST [label="POST /api/plan"];
  REQUEST -> TARGET [lhead=cluster_plan];
  HAS_SIGNAL -> REVIEW [label="yes", ltail=cluster_plan];
  HAS_SIGNAL -> SETUP [label="no · setup only", ltail=cluster_plan];
  REQUEST_ROW -> SETUP [label="available via MCP", ltail=cluster_plan, style=dashed, color="#6b7280"];
  REVIEW -> APPROVE;
  APPROVE -> CONFIRM [label="yes", lhead=cluster_confirm];
  APPROVE -> REJECT [label="no"];
  CREATED -> CRON [ltail=cluster_confirm];

  { rank=same; REVIEW; SETUP; }
  { rank=same; REJECT; CONFIRM; }
}
