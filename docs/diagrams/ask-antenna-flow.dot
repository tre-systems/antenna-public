digraph AskAntennaFlow {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.55",
    nodesep="0.48",
    ranksep="0.72",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    forcelabels=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Ask Antenna: Prompt to Live Signal</B></FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t,
    labeljust=c
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.21,0.13",
    width=2.80,
    height=0.74,
    fixedsize=false,
    fontname="Avenir",
    fontsize=18,
    penwidth=2.4,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff:#ffffff",
    gradientangle=270
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=13,
    fontcolor="#3d4a5c",
    penwidth=2.2,
    arrowsize=0.78
  ];

  // ---- User ----
  U1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Ask Antenna input</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">user types "weather in Madrid"</FONT></TD></TR></TABLE>>];

  // ---- Planner ----
  subgraph cluster_planner {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1e6b43"><B>PLANNER (DETERMINISTIC)</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4e7a61">Keyword / regex matching; source posture derived server-side.</FONT></TD></TR>
        </TABLE>
      >,
      labelloc=t,
      labeljust=l,
      color="#b8e5c8",
      fillcolor="#f4fbf6",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    P1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>POST /api/plan</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">Hono route</FONT></TD></TR></TABLE>>, fillcolor="#eaf8ef:#ffffff", color="#22865a"];
    P2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>match.ts</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">matchHints + paramExtractors</FONT></TD></TR></TABLE>>, fillcolor="#eaf8ef:#ffffff", color="#22865a"];
    P3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Build CollectionPlan</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">signals, missing params, rights posture</FONT></TD></TR></TABLE>>, fillcolor="#eaf8ef:#ffffff", color="#22865a"];
    P4 [
      label=<<B>Any match?</B>>,
      shape=diamond,
      style=filled,
      width=2.7,
      height=1.05,
      fillcolor="#ffffff",
      color="#1f2f46",
      penwidth=2.4
    ];

    P1 -> P2 -> P4;
    P4 -> P3 [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">Yes</FONT></TD></TR></TABLE>>];
  }

  // ---- Registry ----
  subgraph cluster_registry {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#5f3b8a"><B>REGISTRY (TS CODE)</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#6d4d8d">Static modules include match hints, adapters, and rightsStatus.</FONT></TD></TR>
        </TABLE>
      >,
      labelloc=t,
      labeljust=l,
      color="#d6c6ee",
      fillcolor="#fbf8ff",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    REG [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD><B>Connector templates</B></TD></TR>
          <TR><TD><FONT POINT-SIZE="15">weather, FX, crypto, market history,<BR/>GitHub, Calendar, manual, more</FONT></TD></TR>
        </TABLE>
      >,
      fillcolor="#f5f3ff:#ffffff",
      color="#7c3aed",
      width=3.7
    ];
  }

  // ---- Confirmation ----
  subgraph cluster_confirm {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1f5fbf"><B>USER CONFIRMATION</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#496f9f">Plan is shown; user can fill missing params or reject.</FONT></TD></TR>
        </TABLE>
      >,
      labelloc=t,
      labeljust=l,
      color="#b9d8ff",
      fillcolor="#f5faff",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    C1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>PlanPreview UI</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">template, params, rights, missing, auth</FONT></TD></TR></TABLE>>, fillcolor="#edf7ff:#ffffff", color="#2f80ed"];
    C2 [
      label=<<B>Confirm?</B>>,
      shape=diamond,
      style=filled,
      width=2.4,
      height=1.0,
      fillcolor="#ffffff",
      color="#1f2f46",
      penwidth=2.4
    ];

    C1 -> C2;
  }

  // ---- Execution ----
  subgraph cluster_exec {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#0f766e"><B>EXECUTION</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#357a74">Target boundary: owner-scoped plan, server registry, validated config.</FONT></TD></TR>
        </TABLE>
      >,
      labelloc=t,
      labeljust=l,
      color="#99d5cf",
      fillcolor="#f0fdfa",
      style="rounded,filled",
      penwidth=1.8,
      margin=22
    ];

    X1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>POST /api/plan/:id/confirm</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">Hono route</FONT></TD></TR></TABLE>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
    X0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Owner-scoped plan lookup</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">implemented guardrail</FONT></TD></TR></TABLE>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
    X2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Patch missing params only</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">ignore client source / rights / template claims</FONT></TD></TR></TABLE>>, fillcolor="#ffffff", color="#6b7280", style="rounded,filled,dashed"];
    X5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Registry re-resolve</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">policy + config schema</FONT></TD></TR></TABLE>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
    X3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>INSERT signals</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">D1 row with template_id + config</FONT></TD></TR></TABLE>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
    X4 [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Signal renders</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">live values within ~1 min</FONT></TD></TR></TABLE>>,
      fillcolor="#d8f5de:#effcf2",
      color="#15803d",
      penwidth=3.0
    ];

    X1 -> X0 -> X2 -> X5 -> X3 -> X4;
  }

  // ---- Fallback ----
  CR1 [
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>connector_requests row</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">shown in Setup requests</FONT></TD></TR></TABLE>>,
    fillcolor="#fff4d1:#fffaf0",
    color="#d39a00"
  ];

  // ---- Edges ----
  U1 -> P1 [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">prompt</FONT></TD></TR></TABLE>>];
  P2 -> REG [ltail=cluster_planner, lhead=cluster_registry, label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#dfe3e9" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#6b7280">search hints</FONT></TD></TR></TABLE>>, style=dashed, color="#6b7280", fontcolor="#6b7280"];
  P4 -> CR1 [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">No</FONT></TD></TR></TABLE>>];
  P3 -> C1 [ltail=cluster_planner, lhead=cluster_confirm, label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">CollectionPlan</FONT></TD></TR></TABLE>>];
  C2 -> X1 [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">Yes</FONT></TD></TR></TABLE>>, lhead=cluster_exec];
  C2 -> CR1 [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">Save as request</FONT></TD></TR></TABLE>>];
}
