# Antenna — root .env example
#
# Copy this to `.env` and fill in real values. `.env` is gitignored.
#
# These are used by the *wrangler CLI* on your machine (and by GitHub
# Actions via repository secrets). The deployed Worker does NOT read this
# file at runtime — Worker-runtime secrets live in `apps/worker/.dev.vars`
# locally and in `wrangler secret put` in production.

# ----- Cloudflare -----
# Required for: wrangler deploy, wrangler d1 *, wrangler r2 *, wrangler secret *
# Token: https://dash.cloudflare.com/profile/api-tokens
# Use the narrowest permissions supported by your deployment workflow.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
